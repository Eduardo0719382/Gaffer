{
  "name": "gaffer",
  "productName": "Gaffer",
  "version": "0.1.0",
  "description": "Diagramas de iluminación para gaffers",
  "author": "Eduardo Bonilla",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "android:sync": "npm run build && cap sync android"
  },
  "build": {
    "appId": "io.github.eduardo0719382.gaffer",
    "productName": "Gaffer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Eduardo0719382",
        "repo": "Gaffer",
        "releaseType": "release"
      }
    ],
    "fileAssociations": [
      {
        "ext": "gaffer",
        "name": "Proyecto Gaffer",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Gaffer-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "Gaffer"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design",
      "artifactName": "Gaffer-${version}-mac.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "category": "Graphics",
      "artifactName": "Gaffer-${version}.${ext}"
    }
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "electron-updater": "^6.3.9",
    "idb-keyval": "^6.2.1",
    "jspdf": "^2.5.2",
    "konva": "^9.3.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.8.6",
    "electron-builder": "^26.0.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
